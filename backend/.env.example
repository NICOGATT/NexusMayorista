# Plantilla: copiar (no renombrar) a backend/.env y completar. Nunca subir .env al repo.
ENTORNO=desarrollo
LOG_LEVEL=INFO

# Supabase > botón Connect > Session pooler (IPv4). La conexión directa db.xxx.supabase.co
# es solo IPv6 y no funciona en muchas redes ni en Railway/Render.
# Un solo "@" entre la contraseña y el host; si la contraseña tiene "@", escribirlo como %40.
DATABASE_URL=postgresql://postgres.REF_DEL_PROYECTO:CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://REF_DEL_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Supabase > Project Settings > API > JWT Secret (legacy, HS256)
SUPABASE_JWT_SECRET=

ANTHROPIC_API_KEY=

# Meta > Configuración de la app > Básica > Clave secreta de la app
META_APP_SECRET=
# Texto que inventás vos; el mismo va en la configuración del webhook en Meta
META_VERIFY_TOKEN=
WHATSAPP_TOKEN=
# Identificador del número (solo dígitos), no el número de teléfono
WHATSAPP_PHONE_NUMBER_ID=

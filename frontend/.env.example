# Copiar a frontend/.env.local y completar. Nunca subir .env.local al repo.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL del backend FastAPI (en el backend, CORS_ORIGENES debe incluir la URL de este frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000
